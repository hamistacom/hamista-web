<?xml version="1.0"?>
<ruleset name="Hamista" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>Coding standards for the Hamista theme, child theme and Hamista Core plugin.</description>

	<file>wp/hamista</file>
	<file>wp/hamista-core</file>
	<file>wp/hamista-child</file>

	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/inc/plugins/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.WP.I18n"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<!-- Autoloaded classes follow class-<name>.php; the module folder carries the namespace. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/wp/hamista-core/*</exclude-pattern>
	</rule>

	<!-- $default, $class and similar are the conventional names in WordPress-style APIs. -->
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>

	<!-- WordPress template hierarchy needs the post type name, underscores included. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/wp/hamista/*-hm_portfolio*.php</exclude-pattern>
	</rule>

	<!-- Hooks are namespaced with a slash, e.g. hamista_core/settings_saved, like Elementor and WooCommerce do. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hamista"/>
				<element value="Hamista"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hamista"/>
				<element value="hamista-core"/>
				<element value="hamista-child"/>
			</property>
		</properties>
	</rule>
</ruleset>
