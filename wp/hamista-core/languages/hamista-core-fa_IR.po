#: includes/settings/schema.php:1340
msgid "Safe switches that remove WordPress features most sites never use. Each one shaves requests or kilobytes."
msgstr "کلیدهایی بی‌خطر برای حذف قابلیت‌هایی از وردپرس که بیشتر سایت‌ها هرگز به کارشان نمی‌برند. هر کدام چند درخواست یا چند کیلوبایت از بار صفحه کم می‌کند."

#: includes/settings/schema.php:1343
msgid "Block Google Fonts"
msgstr "مسدود کردن گوگل فونت"

#: includes/settings/schema.php:1344
msgid "Stops Elementor and the theme from loading fonts from Google (often slow or blocked in Iran). Hamista fonts are self-hosted."
msgstr "جلوی بارگذاری فونت از گوگل را در المنتور و قالب می‌گیرد (که در ایران اغلب کند یا مسدود است). فونت‌های هامیستا روی سایت خودتان میزبانی می‌شوند."

#: includes/settings/schema.php:1346
msgid "Remove emoji script"
msgstr "حذف اسکریپت ایموجی"

#: includes/settings/schema.php:1347
msgid "Remove oEmbed discovery script"
msgstr "حذف اسکریپت شناسایی oEmbed"

#: includes/settings/schema.php:1348
msgid "Skip Dashicons for visitors"
msgstr "عدم بارگذاری Dashicons برای بازدیدکنندگان"

#: includes/settings/schema.php:1350
msgid "Skip block-editor CSS on Elementor pages"
msgstr "عدم بارگذاری CSS ویرایشگر بلوک در برگه‌های المنتوری"

#: includes/settings/schema.php:1353
msgid "Load WooCommerce cart scripts only where needed"
msgstr "بارگذاری اسکریپت‌های سبد خرید ووکامرس فقط در جای لازم"

#: includes/settings/schema.php:1357
msgid "Prioritise the hero image"
msgstr "بارگذاری فوری تصویر هیرو"

#: includes/settings/schema.php:1358
msgid "Loads the first large image of each page eagerly with high priority."
msgstr "نخستین تصویر بزرگ هر برگه بدون تأخیر و با اولویت بالا بارگذاری می‌شود."

#: includes/settings/schema.php:1361
msgid "Remove jQuery Migrate"
msgstr "حذف jQuery Migrate"

#: includes/settings/schema.php:1362
msgid "Only if your plugins are up to date."
msgstr "فقط اگر افزونه‌هایتان به‌روز هستند."

#: includes/settings/schema.php:1365
msgid "Slow down the Heartbeat API"
msgstr "کاهش تناوب Heartbeat API"

#: includes/settings/schema.php:1368
msgid "Disable XML-RPC"
msgstr "غیرفعال کردن XML-RPC"

#: includes/settings/schema.php:1369
msgid "Improves security. Keep off if you use Jetpack or the WordPress mobile app."
msgstr "امنیت را بیشتر می‌کند. اگر از جت‌پک یا اپلیکیشن موبایل وردپرس استفاده می‌کنید، این گزینه را خاموش نگه دارید."

#: includes/settings/schema.php:1374
msgid "Custom code"
msgstr "کد سفارشی"

#: includes/settings/schema.php:1380
msgid "Custom CSS"
msgstr "CSS سفارشی"

#: includes/settings/schema.php:1385
msgid "Code in <head>"
msgstr "کد در <head>"

#: includes/settings/schema.php:1386
msgid "Analytics, verification tags. Requires the unfiltered_html capability."
msgstr "کدهای آمار و تگ‌های تأیید مالکیت. به مجوز unfiltered_html نیاز دارد."

#: includes/settings/schema.php:1391
msgid "Code before </body>"
msgstr "کد پیش از </body>"

